# 智能导购系统 · 环境变量样例（复制为 .env 使用，切勿提交真实凭据）
# 详细说明见 README.md

# ---- 数据源开关（默认 mock）----
# KESE_PRODUCT_SOURCE=mock | pdd
KESE_PRODUCT_SOURCE=mock

# ---- 拼多多开放平台（KESE_PRODUCT_SOURCE=pdd 时必填）----
# 在 https://open.pinduoduo.com 创建应用后获取
KESE_PDD_CLIENT_ID=
KESE_PDD_CLIENT_SECRET=
# 可选：网关地址 / 请求超时秒数
# KESE_PDD_GATEWAY=https://gw-api.pinduoduo.com/api/router
# KESE_PDD_TIMEOUT_SECONDS=10

# ---- JWT（生产必须替换为强随机密钥）----
# KESE_JWT_SECRET=<openssl rand -hex 32>

# ---- 邮箱验证码 SMTP（不配置则进入调试模式回显验证码）----
# KESE_SMTP_HOST=smtp.example.com
# KESE_SMTP_PORT=465
# KESE_SMTP_USER=you@example.com
# KESE_SMTP_PASSWORD=xxxx
# KESE_SMTP_FROM=you@example.com

# ---- 安全阈值（可调，均有默认值）----
# KESE_CAPTCHA_TTL=180
# KESE_EMAIL_COOLDOWN=60
# KESE_EMAIL_PER_HOUR=5
# KESE_IP_SEND_PER_HOUR=30
# KESE_IP_REGISTER_PER_HOUR=20
# KESE_IP_LOGIN_PER_10MIN=20
# KESE_LOGIN_MAX_FAILURES=5
# KESE_LOGIN_LOCK_SECONDS=900
